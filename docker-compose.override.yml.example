# docker-compose.override.yml.example
#
# Use this file to persistently customize your nself stack.
# Copy to docker-compose.override.yml — it is never overwritten by nself build.
#
# Docker Compose automatically merges this file with docker-compose.yml.
# Only include services and keys you want to override.
#
# Apply changes:
#   nself restart             — apply override changes only
#   nself build && nself restart — regenerate + apply override changes

version: '3.8'

services:
  # --- Example: extra env vars for a plugin ---
  # nself-ai:
  #   environment:
  #     - AI_LOG_LEVEL=debug
  #     - PLUGIN_AI_MEMORY_LIMIT=2g

  # --- Example: expose a port on all interfaces (default: 127.0.0.1 only) ---
  # nself-mux:
  #   ports:
  #     - "0.0.0.0:3712:3712"

  # --- Example: mount a custom config directory ---
  # nself-claw:
  #   volumes:
  #     - ./claw-prompts:/app/prompts:ro

  # --- Example: increase log verbosity for Hasura ---
  # hasura:
  #   environment:
  #     - HASURA_GRAPHQL_LOG_LEVEL=debug

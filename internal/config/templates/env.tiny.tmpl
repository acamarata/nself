# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# nSelf Tiny Profile — optimised for VPS with <1 GB RAM
# Generated by: nself init --profile=tiny
#
# Services enabled: Postgres + nginx only.
# Hasura and Auth are opt-in — uncomment to enable when you
# have at least 1 GB RAM and want GraphQL + authentication.
#
# Upgrade path: add RAM, then re-run: nself init --profile=standard
# Docs: https://github.com/nself-org/cli/wiki/install/tiny-vps
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

PROJECT_NAME={{.ProjectName}}
BASE_DOMAIN={{.BaseDomain}}
ENV=dev

# ── Required service: Postgres ────────────────────────────────
POSTGRES_PASSWORD={{.PostgresPassword}}
POSTGRES_PORT=5432

# Tiny profile: disable Hasura, Auth, and all optional services.
ENABLE_HASURA=false
ENABLE_AUTH=false
ENABLE_MINIO=false
ENABLE_REDIS=false
ENABLE_FUNCTIONS=false
ENABLE_MLFLOW=false
ENABLE_MAIL=false
ENABLE_SEARCH=false

# ── Optional: Hasura (enable when RAM > 1 GB) ─────────────────
# ENABLE_HASURA=true
# HASURA_GRAPHQL_ADMIN_SECRET=CHANGE_ME
# HASURA_JWT_KEY=CHANGE_ME

# ── Optional: Auth (requires Hasura) ─────────────────────────
# ENABLE_AUTH=true

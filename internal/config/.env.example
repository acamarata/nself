# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# nSelf Project Configuration
# Copy to .env and fill in your secrets.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

PROJECT_NAME=myproject
BASE_DOMAIN=local.nself.org
ENV=dev

POSTGRES_PASSWORD=CHANGE_ME
HASURA_GRAPHQL_ADMIN_SECRET=CHANGE_ME
HASURA_JWT_KEY=CHANGE_ME

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Plugin: AI (nself-ai) — multi-provider LLM gateway
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# API key for inter-plugin authentication
# AI_API_KEY=

# Default AI provider: openai, anthropic, cohere, local
# AI_DEFAULT_PROVIDER=openai

# Default sampling temperature (0.0-2.0)
# AI_DEFAULT_TEMPERATURE=0.7

# Default max tokens per response
# AI_DEFAULT_MAX_TOKENS=1000

# OpenAI API key (required when using openai provider)
# AI_OPENAI_API_KEY=

# Anthropic API key (required when using anthropic provider)
# AI_ANTHROPIC_API_KEY=

# Enable local LLM (Ollama) — set base URL
# AI_LOCAL_ENABLED=false
# AI_LOCAL_BASE_URL=http://localhost:11434

# Per-user rate limiting (requests per minute)
# AI_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Per-user daily cost cap in USD
# AI_DEFAULT_DAILY_COST=10.00

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Gemini API keys — used by AI plugin tiered routing
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Gemini Flash-Lite keys (tier 1, free, 60 RPM per key)
# Add multiple keys to increase effective rate limit.
# GEMINI_FREE_KEY_1=
# GEMINI_FREE_KEY_2=
# GEMINI_FREE_KEY_3=
# GEMINI_FREE_KEY_4=

# Gemini Flash keys (tier 2, paid Gemini Flash model, 40 RPM per key)
# GEMINI_FLASH_KEY_1=
# GEMINI_FLASH_KEY_2=

# Alias: treated as GEMINI_FREE_KEY_1
# AI_GOOGLE_API_KEY=

# Provider-level RPM limits for tiered routing
# PLUGIN_AI_GEMINI_FREE_RPM=60
# PLUGIN_AI_GEMINI_FLASH_RPM=40
# PLUGIN_AI_OPENAI_RPM=500
# PLUGIN_AI_ANTHROPIC_RPM=50
# PLUGIN_AI_OLLAMA_RPM=0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Plugin: Claw (nself-claw) — AI personal assistant
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Enable multi-user mode (default: false, single owner only)
# CLAW_MULTI_USER=false

# JWT secret for session tokens (generate with: openssl rand -hex 32)
# CLAW_JWT_SECRET=

# VAPID keys for web push notifications (auto-generated if not set)
# CLAW_VAPID_PUBLIC_KEY=
# CLAW_VAPID_PRIVATE_KEY=
# CLAW_VAPID_SUBJECT=mailto:admin@example.com

# Shared secret between mux and claw plugins (generate with: openssl rand -hex 32)
# MUX_CLAW_SHARED_SECRET=

# Telegram bot integration
# CLAW_TG_BOT_TOKEN=
# CLAW_BASE_URL=
# CLAW_TG_ALLOWED_USERS=

# Allow shell command execution (security: review before enabling)
# NCLAW_ALLOW_SHELL=false

# Proactive intelligence (morning briefings, health alerts)
# NCLAW_PROACTIVE_ENABLED=false
# NCLAW_BRIEFING_TIME=08:00
# NCLAW_QUIET_START=22:00
# NCLAW_QUIET_END=08:00

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CLI operational env vars (nself binary)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Command audit logging — records every CLI command for debugging.
# NSELF_CMD_LOG_ENABLED=true
# NSELF_CMD_LOG_MAX_SIZE_MB=10
# NSELF_CMD_LOG_KEEP_FILES=5

# Health monitor — auto-restarts crashed services.
# NSELF_HEALTH_MAX_RESTARTS=5
# NSELF_HEALTH_POLL_INTERVAL=30s

# Profiling — pprof HTTP endpoint for CPU/memory profiling.
# NSELF_PPROF_BIND=127.0.0.1:6060
# NSELF_PROFILING_TOKEN=

# Pyroscope continuous profiling (optional).
# PYROSCOPE_ENABLED=false
# PYROSCOPE_SERVER_URL=http://pyroscope:4040
# PYROSCOPE_APPLICATION_NAME=nself-cli

# Watchdog escalation — alerts when health checks fail repeatedly.
# Telegram alerts:
# WATCHDOG_TG_BOT_TOKEN=
# WATCHDOG_TG_CHAT_ID=
# Email alerts (SMTP):
# WATCHDOG_SMTP_HOST=smtp.example.com
# WATCHDOG_SMTP_FROM=nself@example.com
# WATCHDOG_SMTP_USER=
# WATCHDOG_SMTP_PASS=

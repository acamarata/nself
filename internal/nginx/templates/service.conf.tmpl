# Generated by nself build - DO NOT EDIT MANUALLY
# Service: {{.Route}}.{{.BaseDomain}}

# Named upstream with keepalive so proxied requests reuse backend TCP
# connections instead of opening a new handshake per request.
upstream {{.UpstreamName}} {
    server {{.Upstream}};
    keepalive 32;
}

server {
{{- if .HasSSL}}
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
{{- else}}
    listen 80;
    listen [::]:80;
{{- end}}
    server_name {{.Route}}.{{.BaseDomain}};
{{if .HasSSL}}
    ssl_certificate /etc/nginx/ssl/certificates/{{.SSLDir}}/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/certificates/{{.SSLDir}}/privkey.pem;
    ssl_trusted_certificate /etc/nginx/ssl/certificates/{{.SSLDir}}/chain.pem;
    ssl_stapling on;
    ssl_stapling_verify on;
{{end}}
    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "0" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'" always;
{{- if .HasSSL}}
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
{{- end}}
    server_tokens off;
    proxy_hide_header X-Powered-By;
    proxy_hide_header Server;

    # Block access to sensitive files and directories
    location ~ /\.(env|git|svn|htaccess|htpasswd|dockerignore) {
        return 404;
    }
    location ~ ^/(docker-compose|Dockerfile) {
        return 404;
    }

    location = /healthz {
        proxy_pass http://{{.Upstream}};
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        {{- if .RateZone}}
        limit_req zone={{.RateZone}} burst={{.Burst}} nodelay;
        {{- end}}
        {{- if .ConnLimit}}
        limit_conn conn_limit_per_ip {{.ConnLimit}};
        {{- end}}
        proxy_pass http://{{.UpstreamName}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass_request_headers on;
        {{- if .WebSocket}}
        proxy_read_timeout 86400;
        {{- end}}
    }
}

  "version": 3,
  "sources": [
    {
      "name": "default",
      "tables": [
        {
          "table": {"schema": "public", "name": "np_servers"},
          "array_relationships": [
            {"name": "channels", "using": {"foreign_key_constraint_on": {"column": "server_id", "table": {"schema": "public", "name": "np_channels"}}}},
            {"name": "members", "using": {"foreign_key_constraint_on": {"column": "server_id", "table": {"schema": "public", "name": "np_members"}}}}

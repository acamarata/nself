{
  "version": 3,
  "sources": [
    {
      "name": "default",
      "tables": [
        {
          "table": {"schema": "public", "name": "np_workspaces"},
          "array_relationships": [{"name": "channels", "using": {"foreign_key_constraint_on": {"column": "workspace_id", "table": {"schema": "public", "name": "np_channels"}}}}],
          "select_permissions": [{"role": "user", "permission": {"columns": "*", "filter": {}}}]
        },
        {
          "table": {"schema": "public", "name": "np_channels"},
          "array_relationships": [
            {"name": "messages", "using": {"foreign_key_constraint_on": {"column": "channel_id", "table": {"schema": "public", "name": "np_messages"}}}}
          ],
          "select_permissions": [{"role": "user", "permission": {"columns": "*", "filter": {"is_private": {"_eq": false}}}}],
          "insert_permissions": [{"role": "user", "permission": {"columns": ["workspace_id","name","is_private","topic","description"], "check": {"created_by": {"_eq": "X-Hasura-User-Id"}}}}]
        },
        {
          "table": {"schema": "public", "name": "np_messages"},
          "array_relationships": [
            {"name": "threads", "using": {"foreign_key_constraint_on": {"column": "parent_message_id", "table": {"schema": "public", "name": "np_threads"}}}},
            {"name": "reactions", "using": {"foreign_key_constraint_on": {"column": "message_id", "table": {"schema": "public", "name": "np_reactions"}}}}
          ],
          "select_permissions": [{"role": "user", "permission": {"columns": "*", "filter": {}}}],
          "insert_permissions": [{"role": "user", "permission": {"columns": ["channel_id","content","attachments"], "check": {"author_id": {"_eq": "X-Hasura-User-Id"}}}}],
          "update_permissions": [{"role": "user", "permission": {"columns": ["content","is_edited"], "filter": {"author_id": {"_eq": "X-Hasura-User-Id"}}}}]
        },
        {
          "table": {"schema": "public", "name": "np_reactions"},
          "select_permissions": [{"role": "user", "permission": {"columns": "*", "filter": {}}}],
          "insert_permissions": [{"role": "user", "permission": {"columns": ["message_id","emoji"], "check": {"user_id": {"_eq": "X-Hasura-User-Id"}}}}],
          "delete_permissions": [{"role": "user", "permission": {"filter": {"user_id": {"_eq": "X-Hasura-User-Id"}}}}]
        }
      ]
    }
  ]
}

# airbnb-clone — copy to .env.dev and fill in values
PROJECT_NAME=my-rental-app
BASE_DOMAIN=localhost

# Hasura
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=change-me

# Auth
AUTH_JWT_SECRET=change-me-32-chars-minimum

# Notify plugin (email for booking confirmations)
NOTIFY_SMTP_HOST=smtp.example.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASS=

# Photos plugin (object storage)
PHOTOS_S3_BUCKET=rental-photos
PHOTOS_S3_ENDPOINT=http://localhost:9000

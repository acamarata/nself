{
  "name": "@nself/plugin-sdk",
  "version": "1.0.13",
  "description": "TypeScript/Node.js plugin authoring SDK for nSelf",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts"
  },
  "files": [
    "dist",
    "templates"
  ],
  "dependencies": {
    "express": "^4.18.3",
    "yaml": "^2.4.1",
    "pino": "^9.1.0"
  },
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nself-org/plugin-sdk-ts.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
